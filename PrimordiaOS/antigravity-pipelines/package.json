{
  "name": "@primordiaos/antigravity-pipelines",
  "version": "1.0.0",
  "description": "Antigravity Pipeline Engine for PrimordiaOS: Multi-Agent DAG Orchestration, Safety Containment, and Distributed Adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/AntigravityPipelineEngine.d.ts",
      "default": "./dist/core/AntigravityPipelineEngine.js"
    },
    "./registry": {
      "types": "./dist/registry/PipelineRegistry.d.ts",
      "default": "./dist/registry/PipelineRegistry.js"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator/PipelineOrchestrator.d.ts",
      "default": "./dist/orchestrator/PipelineOrchestrator.js"
    },
    "./router": {
      "types": "./dist/router/MultiAgentRouter.d.ts",
      "default": "./dist/router/MultiAgentRouter.js"
    },
    "./graph": {
      "types": "./dist/graph/ExecutionGraphEngine.d.ts",
      "default": "./dist/graph/ExecutionGraphEngine.js"
    },
    "./memory": {
      "types": "./dist/memory/PipelineMemoryEngine.d.ts",
      "default": "./dist/memory/PipelineMemoryEngine.js"
    },
    "./safety": {
      "types": "./dist/safety/PipelineSafetyLayer.d.ts",
      "default": "./dist/safety/PipelineSafetyLayer.js"
    },
    "./logging": {
      "types": "./dist/logging/PipelineLogger.d.ts",
      "default": "./dist/logging/PipelineLogger.js"
    },
    "./adapters": {
      "types": "./dist/adapters/AntigravityAdapter.d.ts",
      "default": "./dist/adapters/AntigravityAdapter.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "keywords": [
    "primordiaos",
    "antigravity",
    "pipeline-engine",
    "multi-agent",
    "dag",
    "vertex-ai",
    "gemini",
    "orchestrator"
  ],
  "author": "PrimordiaOS Core Sovereign Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
