# Antigravity Cinematic Profile
# PrimordiaOS Store Asset Forge Realm

style: mythic_os
profile_version: 1.0.0
altitude: sovereign_high

palette:
  void_obsidian: "#07090E"
  substrate_dark: "#0D111A"
  primordial_teal: "#00FFC2"
  stellar_cyan: "#00E5FF"
  celestial_gold: "#FFD700"
  rune_amber: "#FF9100"
  laser_violet: "#A855F7"
  plasma_white: "#F8FAFC"

cinematic_overlays:
  particle_flux:
    emitter: "Niagara.DataInterface.ParticleFlux"
    particle_count: 1200
    color_gradient: ["#00FFC2", "#00E5FF", "#A855F7"]
    velocity_range: [15.0, 85.0]
    turbulence: 0.45
    depth_layer: "ambient_midground"

  realm_sigils:
    sigil_set: ["Sigil_Primordia", "Sigil_MoneyPlug", "Sigil_SovereignCore", "Sigil_ChronosForge"]
    glow_intensity: 2.8
    pulse_rate_hz: 0.5
    holographic_chroma: 0.25
    anchor: "top_right_watermark"

  node_runes:
    font_family: "Primordial Runes Glyphs"
    glyph_stream: ["ᚨ", "ᚱ", "ᚲ", "ᚺ", "ᛟ", "ᚾ", "ᛊ", "ᛏ", "ᛖ", "ᛚ", "ᛚ", "ᚨ"]
    glow_color: "#FFD700"
    opacity: 0.65
    scroll_speed: 1.2

transitions:
  forge_ignition:
    duration_ms: 1200
    curve: "CubicEaseOut"
    flash_color: "#00FFC2"
    camera_shake_trauma: 0.35
    audio_cue: "SFX_Forge_Ignite_Cinematic_SubBass"

  sigil_bloom:
    duration_ms: 800
    curve: "ExponentialBloom"
    bloom_scale: 4.5
    chromatic_aberration: 0.4

  asset_rainfall:
    duration_ms: 1500
    stagger_delay_ms: 80
    gravity_multiplier: 1.8
    impact_ripple: true
