# ==========================================
#   PRIMORDIAOS ENVIRONMENT CONFIG (EXAMPLE)
# ==========================================

# Cockpit (Frontend UI)
PRIMORDIA_COCKPIT_URL=http://localhost:3000

# Plugin-OS (Backend API)
PRIMORDIA_PLUGIN_OS_URL=http://localhost:3001

# Simulation Bridge (WebSocket Telemetry)
PRIMORDIA_SIMULATION_BRIDGE_WS=ws://localhost:4000

# Unreal Simulation Telemetry (Optional)
PRIMORDIA_UNREAL_WS=ws://localhost:7777

# Mobile Node (Galaxy S22+ Termux Client)
PRIMORDIA_MOBILE_NODE_URL=http://localhost:5050

# System Identity
PRIMORDIA_OS_NAME=PrimordiaOS
PRIMORDIA_REALM_DEFAULT=cockpit

# Logging
PRIMORDIA_LOG_LEVEL=info

# Reserved for future modules
PRIMORDIA_KERNEL_URL=http://localhost:3100
PRIMORDIA_VERTEX_URL=http://localhost:3200
PRIMORDIA_VISIONCORE_URL=http://localhost:3300
PRIMORDIA_GENERATOR_URL=http://localhost:3400
PRIMORDIA_OSMIUM_URL=http://localhost:3500
PRIMORDIA_ANTIGRAVITY_URL=http://localhost:3600
