      "altitude": "Syntropic Value Engine",
      "patterns": ["moneyplug", "economy", "affiliate", "posting", "tiktok", "autopost", "syndicate", "3001"]
    },
    "identity_realm": {
      "name": "Identity Realm",
      "slug": "identity",
      "substrate": "Cryptographic Ledger & Cognitive Memory",
      "vessels": ["Osmium Ledger", "Memory Ledger", "Cryptographic Signatures", "Sovereign Profile"],
      "default_port": 3000,
      "protocol": "Cryptographic Hash Chain / Append-Only Ledger",
      "altitude": "Causal / Immutable Core",
      "patterns": ["ledger", "osmium", "identity", "signature", "profile", "hash"]
    }
  },
  "categories": {
    "kernel": {
      "description": "Kernel core state bus, orchestrator, and event broker",
      "patterns": ["kernel", "spine", "bus", "state", "orchestrator", "bootstrap"]
    },
    "agents": {
      "description": "Sovereignty-governed agents and guardian auditors",
      "patterns": ["agent", "guardian", "antigrav", "scribe", "navigator", "engineer"]
    },
    "realms": {
      "description": "Realm adapters and continuous substrate interfaces",
      "patterns": ["realms", "adapter", "substrate"]
    },
    "pipelines": {
      "description": "Integrated execution pipelines",
      "patterns": ["pipeline", "pipelines"]
    },
    "simulation": {
      "description": "Virtual physics and particle simulation engines",
      "patterns": ["simulation", "unreal", "niagara", "physics", "vfx"]
    },
    "identity": {
      "description": "Cryptographic ledgers and sovereign identity",
      "patterns": ["identity", "osmium", "ledger", "signature"]
    },
    "economy": {
      "description": "Monetization and autonomous value engines",
      "patterns": ["economy", "moneyplug", "affiliate", "loop", "syndicate"]
    },
    "interfaces": {
      "description": "User cockpit, live HUD, REST and WebSocket endpoints",
      "patterns": ["interface", "interfaces", "hud", "dashboard", "cli", "rest"]
    },
    "vessels": {
      "description": "Host execution containers and runtime wrappers",
      "patterns": ["vessel", "vessels", "termux", "workstation"]
    },
    "config": {
      "description": "Configurations, ontology, and module registries",
      "patterns": ["config", "ontology", "registry", "realm-map"]
    },
    "docs": {
      "description": "Architecture, ontology, and API documentation",
      "patterns": ["doc", "docs", "architecture", "readme", "guide"]
    },
    "deprecated": {
      "description": "Archived or superseded legacy artifacts",
      "patterns": ["archive", "backup", "legacy", "old", "tmp"]
    }
  },
  "modalities": [
    "compute",
    "event_stream",
    "visual_particles",
    "voice_audio",
    "monetary_value",
    "immutable_ledger",
    "edge_routing"
