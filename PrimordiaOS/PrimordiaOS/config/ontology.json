    "tier_2": {
      "name": "Guardian Agents",
      "authority": "High",
      "powers": ["ANTIGRAV Auditing", "Policy Enforcement", "Collapse Prevention", "Veto Domain Agents"]
    },
    "tier_3": {
      "name": "Domain Agents",
      "authority": "Medium",
