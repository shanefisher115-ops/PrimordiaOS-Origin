{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Primordia Ontology",
  "version": "1.0.0",
  "description": "Ontological classification schema for all PrimordiaOS entities, realms, modules, agents, and pipelines.",
  "sovereignty_hierarchy": {
    "tier_0": {
      "name": "Human Sovereign",
      "entity": "Shane",
      "authority": "Absolute",
      "powers": ["Veto", "Approval", "Sovereignty Rule Evolution", "Realm Authorization"]
    },
    "tier_1": {
      "name": "Primordia Sovereignty Kernel",
      "authority": "Supreme",
      "powers": ["Spine Routing", "State Bus", "Event Broker", "ANTIGRAV Engine"]
