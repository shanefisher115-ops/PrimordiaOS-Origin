    },
    "cloud_realm": {
      "name": "Cloud Realm",
      "slug": "cloud",
      "substrate": "Distributed Edge & Cloud Compute",
      "vessels": ["Cloudflare AI Gateway", "Cloudflare Workers", "Google Cloud Shell", "Cloud Run"],
      "default_port": 443,
      "protocol": "HTTPS / Edge Fetch / AI Gateway API",
      "altitude": "Stratosphere / Global Mesh",
      "patterns": ["cloudflare", "worker", "cloudrun", "cloud", "fly.toml", "wrangler", "gateway"]
    },
    "simulation_realm": {
      "name": "Simulation Realm",
      "slug": "simulation",
      "substrate": "Real-time 3D Virtual & Physics Space",
      "vessels": ["Unreal Engine 5", "Niagara Particle System", "Physics Kernel", "Pixel Stream"],
      "default_port": 17800,
      "protocol": "WebSocket (ws://localhost:17800)",
      "altitude": "Hyper-Dimensional Visualization",
      "patterns": ["unreal", "niagara", "physics", "simulation", "pixelstream", "worldbuilder", "17800"]
