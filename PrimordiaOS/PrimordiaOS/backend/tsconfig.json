{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@primordiaos/core/*": ["src/core/*"],
      "@primordiaos/core": ["src/core"],
      "@primordiaos/kernel/*": ["src/kernel/*"],
      "@primordiaos/kernel": ["src/kernel"],
      "@primordiaos/bus/*": ["src/bus/*"],
      "@primordiaos/bus": ["src/bus"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
