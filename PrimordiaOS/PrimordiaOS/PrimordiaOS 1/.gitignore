# ============================================================
# PRIMORDIAOS MASTER .gitignore
# Unreal Engine + Node.js + TypeScript + Supabase + VS Code
# ============================================================

##############################
# Unreal Engine
##############################

# Build artifacts
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
dist/
out/

# Unreal project files that regenerate
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Crash logs
*.log
*.dmp

# Unreal asset caches
*.uasset
*.umap

# Ignore Engine folder if present
Engine/

##############################
# PrimordiaOS Node Backend
##############################

# Node modules
node_modules/

# Environment variables
.env
.env.local
.env.production
.env.development

# Logs
logs/
*.log

# Build outputs
build/
dist/
out/

# Temporary files
*.tmp
*.temp

##############################
# TypeScript
##############################

# TS build cache
*.tsbuildinfo

##############################
# Supabase
##############################

# Supabase generated migrations (optional)
supabase/migrations/

# Supabase local dev artifacts
supabase/.temp/
supabase/.branches/

##############################
# Electron (if used)
##############################

electron/dist/
electron/out/
electron/build/

##############################
# VS Code
##############################

.vscode/
.history/

##############################
# OS / System Files
##############################

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Mac
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

##############################
# Git
##############################

# Ignore Git conflict backups
*.orig
