# -------------------------
# Node.js / NPM / Yarn
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------
# Next.js (Cockpit)
# -------------------------
.next/
out/
.vercel/

# -------------------------
# Electron (Plugin-OS)
# -------------------------
plugin-os/electron-app/node_modules/
plugin-os/electron-app/dist/

# -------------------------
# Build Artifacts (Global)
# -------------------------
dist/
build/
tmp/
temp/
.cache/
coverage/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.local
.env.*.local
*.env

# -------------------------
# Logs (Global)
# -------------------------
logs/
*.log
error.txt
*.jsonl

# -------------------------
# OS / Editor Noise
# -------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

