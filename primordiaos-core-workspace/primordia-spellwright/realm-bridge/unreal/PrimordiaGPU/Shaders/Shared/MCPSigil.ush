// MCP kernel body: sigil/glyph semantic evaluation.
//
// Every PRS-1 glyph radiates a field. This pass writes it into a voxel volume:
//   rgb = aura light (what the renderer shows), w = signed potential (what actors feel:
//   souls, sigils and gates attract; wards repel, harder as the realm inverts).
// The glyph's shape follows PRS-1 §3.6: `symmetry` lobes around its axis, `complexity`
// deepening them, and a phase derived from its `intent`, so the same intent always
// produces the same pattern and different intents read differently.
//
// Globals the including entry file must declare:
//   StructuredBuffer<FRealmTickGPU> TickBuffer, StructuredBuffer<FSigilGPU> Sigils,
//   RWStructuredBuffer<FFieldVoxelGPU> SigilFieldOut, RWStructuredBuffer<uint> SigilCost
// Dispatch: groups of MCP_GROUP_3D^3 (64) threads; Local is SV_GroupIndex.

groupshared uint GSigilHits[MCP_MAX_SIGILS];

float MCPSquare(float X)
{
	return X * X;
}

void MCPSigilField(uint3 Voxel, uint Local)
{
	const FRealmTickGPU T = TickBuffer[0];
	const uint N = T.Grid.y;
	const uint Count = min(T.Counts.y, MCP_MAX_SIGILS);

	// Per-group hit counters: one shared-memory atomic per contributing voxel, then one
	// global atomic per sigil per group, instead of a global atomic per voxel.
	if (Local < MCP_MAX_SIGILS)
	{
		GSigilHits[Local] = 0;
	}
	GroupMemoryBarrierWithGroupSync();

	if (Voxel.x < N && Voxel.y < N && Voxel.z < N)
	{
		const float3 P = MCPFieldVoxelCenter(Voxel, T.Field);
		const float Clarity = lerp(0.35, 1.0, saturate(T.MetaA.z)); // coherence: glyph clarity
		const float Saturation = lerp(0.85, 0.45, saturate(T.MetaB.y)); // lucidity pales the aura
		float3 Aura = float3(0.0, 0.0, 0.0);
		float Potential = 0.0;
		for (uint S = 0; S < Count; ++S)
		{
			const FSigilGPU G = Sigils[S];
			const float Radius = max(0.25, G.PosScale.w * 0.5);
			const float3 D = P - G.PosScale.xyz;
			const float Dist = length(D);
			// Potential: a glyph rules the column of ground beneath it (vertical distance counts
			// a quarter), out to a reach that grows with its size. Glyphs float well above the
			// ground in PRS-1 realms, and this is what lets actors walking below feel them.
			const float Reach = Radius * 2.0 + 4.0;
			const float ColumnDist = length(float3(D.xy, D.z * 0.25));
			if (Dist > Radius * 4.0 && ColumnDist > Reach * 3.0)
			{
				continue;
			}
			const float Theta = atan2(D.y, D.x);
			const float Spin = T.Time.x * G.Live.w * (0.3 + T.MetaA.w); // resonance: vibration
			const float Rose = 0.5 + 0.5 * cos(G.Shape.x * Theta + G.Live.y + Spin);
			const float Shell = exp(-MCPSquare((Dist - Radius) / (0.2 * Radius + 0.3)));
			const float Halo = exp(-MCPSquare(Dist / (Radius * 2.0)));
			const float Intensity = G.Live.x * (0.35 * Halo + Shell * lerp(1.0, Rose, saturate(G.Shape.y)) * Clarity);
			const float Influence = G.Live.x * exp(-MCPSquare(ColumnDist / Reach));
			if (Intensity < 0.01 && Influence < 0.01)
			{
				continue;
			}
			InterlockedAdd(GSigilHits[S], 1u);
			Aura += MCPHsvToRgb(G.Shape.z, Saturation, 1.0) * Intensity;
			const bool bWard = abs(G.Shape.w - float(MCP_GLYPH_WARD)) < 0.5;
			Potential += (bWard ? -(1.0 + T.MetaB.x) : 1.0) * Influence;
		}
		SigilFieldOut[MCPFieldIndex(Voxel, N)].Value = float4(Aura * (0.4 + 0.6 * T.MetaA.y), Potential);
	}

	GroupMemoryBarrierWithGroupSync();
	if (Local < Count && GSigilHits[Local] > 0u)
	{
		InterlockedAdd(SigilCost[Local], GSigilHits[Local]);
	}
}
