// Unreal entry point for MCPTopology (kernel body: ../Shared/MCPTopology.ush, shared with the standalone
// Vulkan engine). The globals below are bound by FMCPTopologyCS::FParameters in
// Source/MCPComputeBridge/Private/MCPShaders.h; their names are the body's contract.
// numthreads repeats the MCP_GROUP_* constants as literals; MCPShaders.cpp static_asserts them.
#include "/Engine/Public/Platform.ush"
#include "/Plugin/PrimordiaGPU/Shared/MCPTypes.ush"
#include "/Plugin/PrimordiaGPU/Shared/MCPCommon.ush"

StructuredBuffer<FRealmTickGPU> TickBuffer;
StructuredBuffer<FTerrainCellGPU> TerrainIn;
RWStructuredBuffer<FTerrainCellGPU> TerrainOut;

#include "/Plugin/PrimordiaGPU/Shared/MCPTopology.ush"

[numthreads(8, 8, 1)]
void MainCS(uint3 Id : SV_DispatchThreadID)
{
	MCPTopologyMutate(Id.xy);
}
