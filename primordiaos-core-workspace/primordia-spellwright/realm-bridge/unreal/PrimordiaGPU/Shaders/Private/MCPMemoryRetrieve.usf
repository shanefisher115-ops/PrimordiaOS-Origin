// Unreal entry point for MCPMemoryRetrieve (kernel body: ../Shared/MCPMemoryRetrieve.ush, shared with the standalone
// Vulkan engine). The globals below are bound by FMCPMemoryRetrieveCS::FParameters in
// Source/MCPComputeBridge/Private/MCPShaders.h; their names are the body's contract.
// numthreads repeats the MCP_GROUP_* constants as literals; MCPShaders.cpp static_asserts them.
#include "/Engine/Public/Platform.ush"
#include "/Plugin/PrimordiaGPU/Shared/MCPTypes.ush"
#include "/Plugin/PrimordiaGPU/Shared/MCPCommon.ush"

StructuredBuffer<FRealmTickGPU> TickBuffer;
StructuredBuffer<FEpisodeGPU> EpisodesIn;
StructuredBuffer<FActorGPU> ActorsCurrent;
StructuredBuffer<FMemoryGPU> MemoryCurrent;
RWStructuredBuffer<FRecallGPU> RecallOut;
RWStructuredBuffer<FActorCostGPU> ActorCost;

#include "/Plugin/PrimordiaGPU/Shared/MCPMemoryRetrieve.ush"

[numthreads(64, 1, 1)]
void MainCS(uint3 Group : SV_GroupID, uint Local : SV_GroupIndex)
{
	MCPMemoryRetrieve(Group.x, Local);
}
